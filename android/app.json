{
  "expo": {
    "name": "HK Census",
    "slug": "hk-census",
    "version": "1.0.1",
    "icon": "../store-listing/graphics/app-icon-512.png",
    "newArchEnabled": false,
    "orientation": "portrait",
    "scheme": "hkcensus",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "versionCode": 2,
      "package": "com.vkcrystalgem.hkcensus",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../store-listing/graphics/adaptive-icon-foreground.png",
        "backgroundColor": "#0F766E"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "36.0.0",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-asset",
      "./ownership-proof/with-adi-registration",
      "./plugins/with-release-build"
    ]
  }
}
