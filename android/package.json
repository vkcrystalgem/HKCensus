{
  "name": "hkcensus-mobile",
  "version": "1.0.1",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "sync-data": "python ..\\export_mobile_data.py",
    "ios": "expo run:ios",
    "release:apk": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-release.ps1 -ApkOnly",
    "release:bundle": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-release.ps1 -BundleOnly",
    "release:all": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-release.ps1",
    "variants:build": "powershell -ExecutionPolicy Bypass -File .\\variant-builds\\build-variants.ps1",
    "play:release:auto": "powershell -ExecutionPolicy Bypass -File .\\publish-automation\\publish-new-release.ps1",
    "play:publish": "powershell -ExecutionPolicy Bypass -File .\\scripts\\publish-play.ps1"
  },
  "dependencies": {
    "expo": "~54.0.38",
    "expo-asset": "~12.0.14",
    "expo-build-properties": "~1.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
